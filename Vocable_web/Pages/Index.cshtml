@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="container">

    <center>
        <h1 class="headline1">VOCABLE</h1>

        @* Start screen *@
        @if (!Model.GameStarted && !Model.GameEnded)
        {
            <div id="start-screen">
                <p>Press the button to start a 5-question quiz.</p>
                <form method="post">
                    <button type="submit" asp-page-handler="Start" class="submit">Start game</button>
                </form>
            </div>
        }
    </center>

    @* Game screen *@
    @if (Model.GameStarted && !Model.GameEnded)
    {
        var questions = Model.Questions;
        var total = questions.ReadAll().Count;
        var currentIndex = Math.Min(Math.Max(Model.Current, 0), Math.Max(0, total - 1));
        var currentQuestion = total > 0 && Model.Current < total ? questions.ReadAll()[Model.Current] : null;

        <center>
            <div id="game-screen" style="margin-top:1rem;">
                <div>
                    <strong>Question @(Model.Current + 1) of @total</strong>
                </div>

                <div style="margin-top:1rem;">
                    @if (currentQuestion != null)
                    {
                        <img src="@(currentQuestion.HelpImagePath ?? string.Empty)" alt="question-image" style="max-width:200px; margin-bottom: 2rem" />
                    }
                </div>

                <div>
                        <form method="post">
                         
                            <input asp-for="Current" type="hidden" />
                            <input asp-for="Lives" type="hidden" />
                            <input asp-for="CorrectCount" type="hidden" />
                            <input asp-for="ShowEnglishHint" type="hidden" />
                            <input asp-for="ShowSentenceHint" type="hidden" />

                            <label style="">Answer:</label>
                            <input asp-for="Answer" id="answerInput" autocomplete="off" />
                            <button type="submit" asp-page-handler="Submit" class="submit">Submit</button>
                        </form>
                </div>

                <div style="margin-top:1rem;">
                    <span>Lives: </span><span>@Model.Lives</span>
                </div>

                <div style="margin-top:1rem; max-width:600px;">
                    <div>
                        <form method="post" style="display:inline">
                         
                            <input asp-for="Current" type="hidden" />
                            <input asp-for="Lives" type="hidden" />
                            <input asp-for="CorrectCount" type="hidden" />
                            <input asp-for="ShowEnglishHint" type="hidden" />
                            <input asp-for="ShowSentenceHint" type="hidden" />
                            <input asp-for="Answer" type="hidden" />
                            <button type="submit" asp-page-handler="RevealEnglish" class="hint @(Model.ShowEnglishHint ? "revealed" : "blocked")">@(Model.ShowEnglishHint ? (currentQuestion?.HelpEnglish ?? "") : "English hint")</button>
                        </form>
                    </div>
                    <div style="margin-top:0.5rem;">
                        <form method="post" style="display:inline">
                            
                            <input asp-for="Current" type="hidden" />
                            <input asp-for="Lives" type="hidden" />
                            <input asp-for="CorrectCount" type="hidden" />
                            <input asp-for="ShowEnglishHint" type="hidden" />
                            <input asp-for="ShowSentenceHint" type="hidden" />
                            <input asp-for="Answer" type="hidden" />
                            <button type="submit" asp-page-handler="RevealSentence" class="hint @(Model.ShowSentenceHint ? "revealed" : "blocked")">@(Model.ShowSentenceHint ? (currentQuestion?.HelpSentence ?? "") : "Example sentence")</button>
                        </form>
                    </div>
                </div>
                
                <div style="margin-top:1rem;">
                    @if (!string.IsNullOrEmpty(Model.Message)) { <div class="@(Model.MessageClass ?? string.Empty)">@Model.Message</div> }
                    </div>
                
            </div>
        </center>
    }

    <script>
        (function(){
            // When the game screen is present, capture printable key presses anywhere on the page
            // and forward them into the answer input. If an input/textarea is already focused, do nothing.
            function isTextInputFocused() {
                var a = document.activeElement;
                if (!a) return false;
                var tag = a.tagName ? a.tagName.toLowerCase() : '';
                return tag === 'input' || tag === 'textarea' || a.isContentEditable;
            }

            document.addEventListener('keydown', function (e) {
                try {
                    var game = document.getElementById('game-screen');
                    if (!game) return; // only active during game

                    if (isTextInputFocused()) return; // already typing somewhere

                    // ignore modifier-only keys
                    if (e.ctrlKey || e.metaKey || e.altKey) return;

                    var input = document.getElementById('answerInput');
                    if (!input) return;

                    // Printable characters have length 1 for e.key
                    if (e.key && e.key.length === 1) {
                        // insert character at caret position
                        var start = input.selectionStart != null ? input.selectionStart : input.value.length;
                        var end = input.selectionEnd != null ? input.selectionEnd : start;
                        input.value = input.value.slice(0, start) + e.key + input.value.slice(end);
                        // focus and move caret
                        input.focus();
                        var pos = start + 1;
                        input.setSelectionRange(pos, pos);
                        e.preventDefault();
                    }
                    else if (e.key === 'Backspace') {
                        // focus so user can use backspace
                        input.focus();
                    }
                }
                catch (ex) {
                    // swallow errors - non-critical
                }
            }, false);
        })();
    </script>

    @* End screen *@
    @if (Model.GameEnded)
    {
        <center>
            <div id="end-screen" style="margin-top:1rem;">
                <h3>Quiz finished</h3>
                <div>@Model.FinalMessage</div>
                <form method="post">
                    <button type="submit" asp-page-handler="PlayAgain" class="submit">Play Again</button>
                </form>
            </div>
        </center>
    }

</div>