@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="container">

    <center>
        <h1 class="headline1">VOCABLE</h1>

        @* Start screen *@
        @if (!Model.QS.GameStarted && !Model.QS.GameEnded)
        {
            <div id="start-screen">
                <p>Press the button to start a 5-question quiz.</p>
                <form method="post">
                    <button type="submit" asp-page-handler="Start" class="submit">Start game</button>
                </form>
            </div>
        }
    </center>

    @* Game screen *@
    @if (Model.QS.GameStarted && !Model.QS.GameEnded)
    {
        var questions = Model.Questions;
        var total = questions.ReadAll().Count;
        var currentIndex = Math.Min(Math.Max(Model.QS.Current, 0), Math.Max(0, total - 1));
        var currentQuestion = total > 0 && Model.QS.Current < total ? questions.ReadAll()[Model.QS.Current] : null;

        <center>
            <div id="game-screen" style="margin-top:1rem;">
                <div>
                    <strong>Question @(Model.QS.Current + 1) of @total</strong>
                </div>

                <div style="margin-top:1rem;">
                    @if (currentQuestion != null)
                    {
                         var originalSrc = currentQuestion.HelpImagePath ?? string.Empty; 
                        <img id="questionImage" src="@(Model.QS.ShowCorrectAnimation ? "/images/correct_image.gif" : originalSrc)" data-original-src="@originalSrc" alt="question-image" style="max-width:200px; margin-bottom: 2rem" />
                    }
                </div>

                <div>
                        <form method="post">
                         
                            <input asp-for="QS.Current" type="hidden" />
                            <input asp-for="QS.Lives" type="hidden" />
                            <input asp-for="QS.CorrectCount" type="hidden" />
                            <input asp-for="QS.ShowEnglishHint" type="hidden" />
                            <input asp-for="QS.ShowSentenceHint" type="hidden" />

                            @* <label style="">Answer:</label> *@
                            <input asp-for="Answer" id="answerInput" class="answerButton" autocomplete="off" />
                            <button type="submit" asp-page-handler="Submit" class="submit">Submit</button>
                        </form>
                </div>

                <div style="margin-top:1rem;">
                  @*   <span>Lives: </span> *@
                    <span class="lives" aria-label="Lives">
                        @{
                            var maxLives = 3;
                            for (int i = 0; i < maxLives; i++)
                            {
                                if (i < Model.QS.Lives)
                                {
                                    <text><span class="life full" aria-hidden="true">♥</span></text>
                                }
                                else
                                {
                                    <text><span class="life empty" aria-hidden="true">♡</span></text>
                                }
                            }
                        }
                    </span>
                </div>

                <div style="margin-top:1rem; max-width:600px;">
                    <div>
                        <form method="post" style="display:inline">
                         
                            <input asp-for="QS.Current" type="hidden" />
                            <input asp-for="QS.Lives" type="hidden" />
                            <input asp-for="QS.CorrectCount" type="hidden" />
                            <input asp-for="QS.ShowEnglishHint" type="hidden" />
                            <input asp-for="QS.ShowSentenceHint" type="hidden" />
                            <input asp-for="Answer" type="hidden" />
                            <button type="submit" asp-page-handler="RevealEnglish" class="hint @(Model.QS.ShowEnglishHint ? "revealed" : "blocked")">@(Model.QS.ShowEnglishHint ? (currentQuestion?.HelpEnglish ?? "") : "English hint")</button>
                        </form>
                    </div>
                    <div style="margin-top:0.5rem;">
                        <form method="post" style="display:inline">
                            
                            <input asp-for="QS.Current" type="hidden" />
                            <input asp-for="QS.Lives" type="hidden" />
                            <input asp-for="QS.CorrectCount" type="hidden" />
                            <input asp-for="QS.ShowEnglishHint" type="hidden" />
                            <input asp-for="QS.ShowSentenceHint" type="hidden" />
                            <input asp-for="Answer" type="hidden" />
                            <button type="submit" asp-page-handler="RevealSentence" class="hint @(Model.QS.ShowSentenceHint ? "revealed" : "blocked")">@(Model.QS.ShowSentenceHint ? (currentQuestion?.HelpSentence ?? "") : "Example sentence")</button>
                        </form>
                    </div>
                </div>
                
                <div style="margin-top:1rem;">
                    @if (!string.IsNullOrEmpty(Model.QS.Message)) { <div class="@(Model.QS.MessageClass ?? string.Empty)">@Model.QS.Message</div> }
                    </div>
                
            </div>
        </center>
    }

    @* Correct answer animation overlay (plays once for 1.7 second) *@
    @if (Model.QS.ShowCorrectAnimation)
    {
        <script>
            (function(){
                try {
                    var img = document.getElementById('questionImage');
                    if (!img) return;
                    setTimeout(function(){
                        var orig = img.getAttribute('data-original-src') || '';
                        img.setAttribute('src', orig);
                    }, 1700);
                }
                catch (e) {
                    // ignore
                }
            })();
        </script>
    }


    <script>
        (function(){
            // When the game screen is present, capture printable key presses anywhere on the page
            // and forward them into the answer input. If an input/textarea is already focused, do nothing.
            function isTextInputFocused() {
                const active = document.activeElement;
                if (!active) return false;
                var tag = active.tagName ? active.tagName.toLowerCase() : '';
                return tag === 'input' || tag === 'textarea' || active.isContentEditable;
            }

            document.addEventListener('keydown', function (e) {
                try {
                    var game = document.getElementById('game-screen');
                    if (!game) return; // only active during game

                    if (isTextInputFocused()) return; // already typing somewhere

                    // ignore modifier-only keys
                    if (e.ctrlKey || e.metaKey || e.altKey) return;

                    var input = document.getElementById('answerInput');
                    if (!input) return;

                    // Printable characters have length 1 for e.key
                    if (e.key && e.key.length === 1) {
                        // insert character at caret position
                        var start = input.selectionStart != null ? input.selectionStart : input.value.length;
                        var end = input.selectionEnd != null ? input.selectionEnd : start;
                        input.value = input.value.slice(0, start) + e.key + input.value.slice(end);
                        // focus and move caret
                        input.focus();
                        var pos = start + 1;
                        input.setSelectionRange(pos, pos);
                        e.preventDefault();
                    }
                    else if (e.key === 'Backspace') {
                        // focus so user can use backspace
                        input.focus();
                    }
                }
                catch (ex) {
                    // swallow errors - non-critical
                }
            }, false);
        })();
    </script>

    @* End screen *@
    @if (Model.QS.GameEnded)
    {
        <center>
            <div id="end-screen" style="margin-top:1rem;">
                <h3>Quiz finished</h3>
                <div>@Model.QS.FinalMessage</div>
                <h3>High Score: @Model.QS.HighScore / 5000</h3>
                <form method="post">
                    <button type="submit" asp-page-handler="PlayAgain" class="submit">Play Again</button>
                </form>
            </div>
        </center>
    }

</div>

@* Explainer button and modal *@


<button id="explainerBtn" class="explainer-button">?</button>

<div id="explainerOverlay" class="explainer-overlay" role="dialog" aria-modal="true" aria-hidden="true">
    <center>
        <div class="explainer-modal">
        <button id="explainerClose" class="explainer-close" aria-label="Close">×</button>

        <h3>What is vocable?</h3>
        <p>I made this game for myself to memerize spanish verbs. I always liked the 'DLEs games, where you do a daily, random puzzle and then can easily forget about after. 
            But the habit remains. Also, this is a small project to try out drawing small animations, and learn some basic code (this was written in razor-pages with .NET).
        
        </p>

        <h3>How to play</h3>
        <p>
            A small animation will loop. It is your job to type the spanish verb in infinitive, given this hint. <br />            
            You are given two hints if you can't remember or decipher the animation.<br /> 
            press the english word. If this is the first time seeing this word, there is also a spanish sentence. <br />
            you have three attempts per verb, shown in hearts like this:<br />
            <span style="color: red"> ♥ ♥ ♥</span>
        </p>
            <h3>Good luck! / ¡buena suerte!</h3>
        @* <h3>Headline 3</h3>
        <p>Fusce nec tellus sed augue semper porta. Mauris massa. Vestibulum lacinia arcu eget nulla.</p> *@
    </div>
    </center>
</div>

<script>
    (function () {
        var btn = document.getElementById('explainerBtn');
        var overlay = document.getElementById('explainerOverlay');
        var closeBtn = document.getElementById('explainerClose');

        function open() {
            overlay.style.display = 'flex';
            overlay.setAttribute('aria-hidden', 'false');
            // prevent background scroll when open
            document.body.style.overflow = 'hidden';
        }

        function close() {
            overlay.style.display = 'none';
            overlay.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';
        }

        if (btn) btn.addEventListener('click', open);
        if (closeBtn) closeBtn.addEventListener('click', close);

        // click outside modal to close
        if (overlay) overlay.addEventListener('click', function (e) {
            if (e.target === overlay) close();
        });

        // close with Escape
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && overlay.style.display === 'flex') close();
        });
    })();
</script>
